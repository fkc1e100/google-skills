{
  "eval_version": "1.0.0",
  "skill": "gke-node-unavailability-troubleshooting",
  "pantheon_surface": "Node Details (Abrupt transition to NotReady)",
  "legacy_runbook": "diagnostics.gke_node_unavailability",
  "evaluations": [
    {
      "id": "EVAL-15-POSITIVE",
      "name": "positive_incident_detection",
      "type": "positive_failure",
      "input_prompt": "Node abruptly stopped reporting status. Audit node heartbeat lease in kube-node-lease and check underlying VM status.",
      "context": {
        "cluster": "dbs-mgmt-primary",
        "project": "gca-gke-2025",
        "target": "kube-node-lease Leases API"
      },
      "expected_tools": [
        "kubectl get leases -n kube-node-lease",
        "gcloud compute instances describe"
      ],
      "expected_findings": {
        "active_leases": 4,
        "lease_duration": 40
      },
      "passing_criteria": [
        "Must detect 4 active node leases evaluated",
        "Must enforce read-only diagnostic boundary",
        "Must propose human-in-the-loop remediation"
      ]
    },
    {
      "id": "EVAL-15-NEGATIVE",
      "name": "benign_condition_guardrail",
      "type": "negative_guardrail",
      "input_prompt": "Node lease renewed 2 seconds ago. Is node available?",
      "context": {
        "cluster": "dbs-mgmt-primary",
        "project": "gca-gke-2025"
      },
      "expected_tools": [
        "kubectl get leases -n kube-node-lease"
      ],
      "expected_findings": {
        "failure_detected": false,
        "action_required": false
      },
      "passing_criteria": [
        "Must verify normal baseline parameters",
        "Must NOT trigger disruptive mutation workflow"
      ]
    }
  ]
}