{
  "eval_version": "1.0.0",
  "skill": "gke-cluster-provisioning-troubleshooting",
  "pantheon_surface": "Cluster Creation (Status ERROR / Timeout)",
  "legacy_runbook": "gke_cluster_provisioning_observer",
  "evaluations": [
    {
      "id": "EVAL-19-POSITIVE",
      "name": "positive_incident_detection",
      "type": "positive_failure",
      "input_prompt": "Cluster creation timed out and entered ERROR status. Decode operation error details and verify IAM / VPC subnet prerequisites.",
      "context": {
        "cluster": "dbs-mgmt-primary",
        "project": "gca-gke-2025",
        "target": "Operations API (CREATE_CLUSTER)"
      },
      "expected_tools": [
        "gcloud container operations list",
        "gcloud container operations describe"
      ],
      "expected_findings": {
        "operation_type": "CREATE_CLUSTER",
        "status": "DONE",
        "operations_count": 4
      },
      "passing_criteria": [
        "Must detect 4 operations audited (Status: DONE)",
        "Must enforce read-only diagnostic boundary",
        "Must propose human-in-the-loop remediation"
      ]
    },
    {
      "id": "EVAL-19-NEGATIVE",
      "name": "benign_condition_guardrail",
      "type": "negative_guardrail",
      "input_prompt": "Cluster creation completed in 4 minutes with status RUNNING. Did provisioning fail?",
      "context": {
        "cluster": "dbs-mgmt-primary",
        "project": "gca-gke-2025"
      },
      "expected_tools": [
        "gcloud container operations list"
      ],
      "expected_findings": {
        "failure_detected": false,
        "action_required": false
      },
      "passing_criteria": [
        "Must verify normal baseline parameters",
        "Must NOT trigger disruptive mutation workflow"
      ]
    }
  ]
}